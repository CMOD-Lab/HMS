@page
@model DBProject.Pages.Patient.PatientFeedbackModel

@section Head {
    <title>Feedback</title>
}

<h1><strong style="margin:37%">Feedback</strong></h1>
<br /><br />

<div style="margin-left: 70px">

    <span id="Feedback" style="font-weight:bold;font-size:medium">@Model.FeedbackMessage</span>
    <br /><br />

    <span id="FDoctor" style="font-weight:bold;font-size:medium">@Model.FDoctor</span>
    <br /><br />

    <span id="FTimings" style="font-weight:bold;font-size:medium">@Model.FTimings</span>
    <br /><br />

    <br /><br />

    @if (Model.ShowForm)
    {
        <form method="post">
            <input type="hidden" name="FDoctor" value="@Model.FDoctor" />
            <input type="hidden" name="FTimings" value="@Model.FTimings" />

            <span id="Message" style="font-weight:bold;font-size:medium">Dear Patient, How was your treatment experience with our specialized Doctor on a rating of 1 - 5:</span>

            <div style="margin-left: 790px">
                <select id="List" name="Rating" style="font-weight:bold">
                    @for (int r = 1; r <= 5; r++)
                    {
                        <option value="@r" selected="@(Model.Rating == r)">@r</option>
                    }
                </select>

                <br /><br />

                <button type="submit" id="button1" style="font-weight:bold">Give Feedback</button>

                <br /><br />
                <span id="F" style="font-weight:bold;font-size:medium">@Model.ResultMessage</span>
            </div>
        </form>
    }
    else
    {
        <div style="margin-left: 790px">
            <span id="F" style="font-weight:bold;font-size:medium">@Model.ResultMessage</span>
        </div>
    }

    <br /><br />
</div>
