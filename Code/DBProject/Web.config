<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  http://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>

  <configSections>
    <section name="aws" type="Amazon.AWSConfigSection, AWSSDK.Core, Version=4.1.1.0, Culture=neutral, PublicKeyToken=885c28607f986326" />
  </configSections>

  <!-- AWS SDK logging configuration (cloud-services skill: safe logging)
       Prevents AWS SDK from logging request/response bodies, secrets, and wire data.
       logResponses="Never" ensures no response bodies (which may contain secrets) are logged.
       logTo="None" disables AWS SDK internal logging entirely. -->
  <aws>
    <logging logTo="None" logResponses="Never" logMetrics="false" />
  </aws>

  <system.diagnostics>
    <!-- HTTP wire and request loggers at WARN (cloud-services skill: safe logging) -->
    <sources>
      <source name="System.Net" switchValue="Warning">
        <listeners>
          <add name="console" type="System.Diagnostics.ConsoleTraceListener" />
        </listeners>
      </source>
      <source name="System.Net.Http" switchValue="Warning">
        <listeners>
          <add name="console" type="System.Diagnostics.ConsoleTraceListener" />
        </listeners>
      </source>
    </sources>
    <switches>
      <!-- AWS SDK HTTP wire logging disabled (cloud-services skill: safe logging) -->
      <add name="Amazon" value="Warning" />
      <!-- Content Security Policy enforcement via SecurityHeadersModule (cr-dotnet-1041) -->
      <!-- CSP headers are injected by DBProject.SecurityHeadersModule in PreSendRequestHeaders -->
      <!-- AWS WAF provides additional protection at the edge (cr-dotnet-1041) -->
    </switches>
  </system.diagnostics>


    <connectionStrings>
      <!-- Connection string externalized to environment variable Database__ConnectionString / AWS SSM Parameter Store -->
      <add name="sqlCon1" connectionString="" providerName="System.Data.SqlClient" />
    </connectionStrings>

    <appSettings>
      <!-- Redis connection string for distributed session and cache (cr-dotnet-0045, cr-dotnet-0126) -->
      <!-- Set Redis__ConnectionString environment variable or via AWS SSM Parameter Store -->
      <add key="Redis:ConnectionString" value="" />
      <!-- AWS region for SDK credential resolution -->
      <add key="AWS:Region" value="us-east-1" />
    </appSettings>

  
     
  <system.net>
    <settings>
      <servicePointManager checkCertificateRevocationList="true" securityProtocol="Tls12" />
    </settings>
  </system.net>
  <runtime>
    <AppContextSwitchOverrides value="Switch.System.Net.DontEnableSchUseStrongCrypto=false" />
  </runtime>
  <system.web>
    <compilation debug="true" targetFramework="4.8"/>
    <httpRuntime targetFramework="4.8"/>
    <!-- Redis-backed distributed session state (cr-dotnet-0045) -->
    <!-- Replaces InProc session state for horizontal scaling across multiple instances -->
    <sessionState mode="Custom" customProvider="RedisSessionProvider" timeout="20" cookieName="Clinic.Session">
      <providers>
        <add name="RedisSessionProvider"
             type="Microsoft.Web.Redis.RedisSessionStateProvider"
             host=""
             port="6379"
             accessKey=""
             ssl="false"
             throwOnError="false"
             retryTimeOut="1"
             connectionIdleTimeoutinSeconds="10"
             operationTimeoutinMilliseconds="100000" />
      </providers>
    </sessionState>
    <httpModules>
      <add name="ApplicationInsightsWebTracking" type="Microsoft.ApplicationInsights.Web.ApplicationInsightsHttpModule, Microsoft.AI.Web"/>
      <!-- Content Security Policy HttpModule (cr-dotnet-1041) -->
      <add name="SecurityHeadersModule" type="DBProject.SecurityHeadersModule, DBProject" />
    </httpModules>
  </system.web>
  <system.codedom>
    <compilers>
      <compiler language="c#;cs;csharp" extension=".cs"
        type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=1.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"
        warningLevel="4" compilerOptions="/langversion:6 /nowarn:1659;1699;1701"/>
      <compiler language="vb;vbs;visualbasic;vbscript" extension=".vb"
        type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=1.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"
        warningLevel="4" compilerOptions="/langversion:14 /nowarn:41008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+"/>
    </compilers>
  </system.codedom>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false"/>
    <modules>
      <remove name="ApplicationInsightsWebTracking"/>
      <add name="ApplicationInsightsWebTracking" type="Microsoft.ApplicationInsights.Web.ApplicationInsightsHttpModule, Microsoft.AI.Web"
        preCondition="managedHandler"/>
      <!-- Content Security Policy HttpModule (cr-dotnet-1041) -->
      <add name="SecurityHeadersModule" type="DBProject.SecurityHeadersModule, DBProject" />
    </modules>
  </system.webServer>
</configuration>
